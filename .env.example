# Public browser configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Development-only UI adapters. Keep false in production.
VITE_ENABLE_MOCKS=false

# Supabase Edge Function secrets (never prefix these with VITE_)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
MAPY_API_KEY=YOUR_MAPY_CZ_REST_API_KEY
MAPY_ROUTING_BASE_URL=https://api.mapy.com/v1/routing/route
MAPY_GEOCODING_BASE_URL=https://api.mapy.com/v1/geocode
ARES_BASE_URL=https://ares.gov.cz/ekonomicke-subjekty-v-be/rest/ekonomicke-subjekty
# The public ARES REST API currently does not require a key. Reserved if policy changes.
ARES_API_KEY=

# One-time server-side admin bootstrap. Supabase Auth stores the password as a salted hash.
ADMIN_BOOTSTRAP_EMAIL=admin@example.cz
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_BEFORE_BOOTSTRAP

# Fixed delivery configuration
SHIPPING_ORIGIN_ADDRESS=Všesulov 4, 270 34 Všesulov
SHIPPING_RATE_CZK_PER_KM=35
